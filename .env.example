# AETHER-OS Environment Configuration

# LLM Provider: "gemini" (Recommended Free Tier) or "ollama" (100% Local) or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get a 100% free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama Settings (Optional, for 100% offline local vision models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:7b

# Voice Persona (Free Edge-TTS: en-US-ChristopherNeural, en-US-AriaNeural, en-GB-RyanNeural, etc.)
DEFAULT_VOICE=en-US-ChristopherNeural

# Safety Settings
FAILSAFE_ENABLED=true
MAX_STEPS_PER_TASK=25
MOUSE_MOVE_DURATION=0.35
